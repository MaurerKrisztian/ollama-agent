{
  "name": "local-model-chat",
  "version": "1.1.2",
  "description": "React + Node.js + TS Ollama Agent Chat UI & CLI",
  "type": "module",
  "bin": {
    "agent": "./agent"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c cyan,magenta \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --config src/client/vite.config.ts src/client",
    "start:no-watch": "npm run build:client && PORT=3002 tsx src/server/index.ts",
    "build": "npm run build:client && npm run build:server",
    "cli": "tsx src/cli/index.ts",
    "build:client": "vite build --config src/client/vite.config.ts src/client",
    "build:server": "tsc",
    "start": "node dist/server/index.js",
    "benchmark:image": "docker build --file Dockerfile.benchmark --tag local-model-chat-benchmark:node20 .",
    "benchmark:browsecomp": "tsx src/benchmark/browsecomp/cli.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@mozilla/readability": "^0.6.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "inquirer": "^9.3.2",
    "jsdom": "^24.1.3",
    "lucide-react": "^0.395.0",
    "monaco-editor": "^0.56.0",
    "ollama": "^0.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "turndown": "^7.2.4",
    "vite-plugin-monaco-editor": "^1.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^9.0.7",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.4",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
